generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkillCategory {
  LANGUAGE
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  TOOLING
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  description String
  techStack   String[]
  githubUrl   String?
  liveUrl     String?
  imageUrl    String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured, sortOrder])
}

model Skill {
  id          String        @id @default(cuid())
  name        String        @unique
  category    SkillCategory
  proficiency Int           @default(3) // 1-5
  sortOrder   Int           @default(0)

  @@index([category, sortOrder])
}

model Experience {
  id          String    @id @default(cuid())
  company     String
  role        String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String[]
  sortOrder   Int       @default(0)

  @@index([sortOrder])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
